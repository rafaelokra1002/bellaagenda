# Copie para .env e preencha. Nunca versione o arquivo .env.

# Conexão PostgreSQL (local via docker compose, ou o banco gerenciado em produção).
# Em produção use sslmode=require quando o provedor exigir.
DATABASE_URL="postgresql://bella:bella_dev_password@localhost:5433/bellaagenda?schema=public"

# Banco separado usado SOMENTE pelos testes de integração (é apagado a cada execução).
TEST_DATABASE_URL="postgresql://bella:bella_dev_password@localhost:5433/bellaagenda_test?schema=public"

# URL pública da aplicação (sem barra no final). Usada em links e no cookie de sessão.
APP_URL="http://localhost:3000"

# Duração da sessão do painel, em dias.
SESSION_TTL_DAYS="7"

# Fuso padrão para novas profissionais.
DEFAULT_TIMEZONE="America/Bahia"

# --- Futuro: WhatsApp Business Platform (Cloud API) ---
# Ainda NÃO utilizado pela aplicação. Preencha só quando a integração oficial for implementada.
# WHATSAPP_CLOUD_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
